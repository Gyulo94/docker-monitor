<ui:FluentWindow x:Class="docker_monitor.Dialogs.LogExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="로그 내보내기 설정" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource IndigoBlackGradientBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="내보낼 로그 범위를 선택하세요" 
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="빠른 선택" FontWeight="Medium" Margin="0,0,0,10"/>
            <UniformGrid Columns="3">
                <ui:Button Content="오늘" Margin="2" Click="OnTodayClick"/>
                <ui:Button Content="최근 7일" Margin="2" Click="OnLast7DaysClick"/>
                <ui:Button Content="최근 30일" Margin="2" Click="OnLast30DaysClick"/>
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="사용자 지정 범위" FontWeight="Medium" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="시작 날짜" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                    <DatePicker x:Name="StartDatePicker" SelectedDateChanged="OnDateChanged"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Bottom" Margin="10,0,10,5" FontSize="20"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="종료 날짜" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                    <DatePicker x:Name="EndDatePicker" SelectedDateChanged="OnDateChanged"/>
                </StackPanel>
            </Grid>
            
            <TextBlock x:Name="SelectionSummary" Margin="0,20,0,0" 
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="취소" Width="80" Margin="0,0,10,0" Click="OnCancelClick"/>
            <ui:Button Content="내보내기" Appearance="Primary" Width="100" Click="OnExportClick" Icon="{ui:SymbolIcon ArrowDownload24}"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
