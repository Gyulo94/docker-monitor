<UserControl x:Class="docker_monitor.Views.ContainerDetailsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              mc:Ignorable="d" 
              d:DesignHeight="750" d:DesignWidth="1100">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Cube24" FontSize="32" Margin="0,0,15,0" Foreground="{StaticResource IndigoPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="컨테이너 상세:" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ContainerName}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource IndigoPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding ContainerId}" Foreground="#FFAAAAAA" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <ui:Button Content="로그 다운로드" Icon="{ui:SymbolIcon ArrowDownload24}" 
                                   Appearance="Secondary" Margin="0,0,8,0" Padding="12,5"
                                   Click="OnDownloadClick" />
                    </StackPanel>

                    <Border VerticalAlignment="Center" Background="{StaticResource IndigoPrimaryBrush}" Padding="12,4" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FF00FF00" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SocketStatus}" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLogsExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Border Style="{StaticResource GlassCardStyle}" Padding="15" Height="240" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock Text="실시간 CPU (%)" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5"/>
                            <lvc:PieChart Series="{Binding CpuGaugeSeries}" InitialRotation="-90" MaxAngle="270" Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="15" Height="240" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock Text="실시간 메모리 (%)" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5"/>
                            <lvc:PieChart Series="{Binding MemoryGaugeSeries}" InitialRotation="-90" MaxAngle="270" Margin="0,10,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Style="{StaticResource GlassCardStyle}" Padding="15" Height="240" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock Text="CPU 사용량 추이 (%)" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5"/>
                            <lvc:CartesianChart Series="{Binding CpuSeries}" XAxes="{Binding XAxes}" YAxes="{Binding CpuYAxes}" Margin="0,15,0,0" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="15" Height="240" Margin="0,0,0,15">
                        <Grid>
                            <TextBlock Text="메모리 사용량 추이 (MB)" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5"/>
                            <lvc:CartesianChart Series="{Binding MemorySeries}" XAxes="{Binding XAxes}" YAxes="{Binding MemoryYAxes}" Margin="0,15,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLogsExpanded}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Background" Value="#FF111111" />
                                <Setter Property="Margin" Value="0,-10,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="15,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,10,0" Foreground="White" />
                            <TextBlock Text="로그 터미널" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding LogCountDisplay}" Foreground="#FFAAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            
                            <ui:Button Command="{Binding LoadMoreCommand}"
                                       Content="과거 로그 더보기"
                                       Icon="{ui:SymbolIcon History24}"
                                       Padding="8,2" FontSize="11"
                                       Appearance="Secondary" />
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right" 
                                   Command="{Binding ToggleLogsCommand}"
                                   Padding="12,5"
                                   FontSize="12">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Content" Value="크게보기" />
                                    <Setter Property="Icon" Value="{ui:SymbolIcon Maximize24}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLogsExpanded}" Value="True">
                                            <Setter Property="Content" Value="작게보기" />
                                            <Setter Property="Icon" Value="{ui:SymbolIcon ArrowMinimize24}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </Grid>

                    <ScrollViewer x:Name="LogsScrollViewer" Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" Background="#1A000000" Padding="15"
                                  ScrollChanged="LogsScrollViewer_ScrollChanged"
                                  PreviewMouseWheel="LogsScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding DisplayLogs}"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Message, Mode=OneWay}" 
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontFamily="Consolas" 
                                             FontSize="13" 
                                             Padding="0"
                                             Margin="0,2"
                                             TextWrapping="NoWrap"
                                             IsUndoEnabled="False"
                                             SelectionBrush="{StaticResource IndigoPrimaryBrush}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="#FF00FF00" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="Foreground" Value="#FFFF5555" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="Foreground" Value="#FFFFA500" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
